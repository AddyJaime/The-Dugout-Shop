{
  "name": "the-dugout-shop",
  "packageManager": "pnpm@10.30.3",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
